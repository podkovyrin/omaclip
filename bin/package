#!/usr/bin/env bash
# Produce a self-contained OmaClip plugin archive, without system dependencies.
set -euo pipefail
cd "$(dirname "$0")/.."
./bin/build
omarchy plugin validate .
version=$(python3 -c 'import json; print(json.load(open("manifest.json"))["version"])')
mkdir -p dist
archive="dist/omaclip-${version}-$(uname -m).tar.gz"
tar -czf "$archive" manifest.json Panel.qml ClipboardView.qml BridgeBackend.qml Service.qml \
  README.md LICENSE NOTICE CHANGELOG.md bin/omaclip bin/omaclip-rs bin/check-deps
(cd dist && sha256sum "$(basename "$archive")" > "$(basename "$archive").sha256")
printf 'Created %s\n' "$archive"
